{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["demo/**"],
  "ignoreDependencies": [
    "@vanilla-extract/css",
    "@vanilla-extract/recipes",
    "@vanilla-extract/vite-plugin",
    "unplugin-dts",
    "typescript",
    "vite",
    "rollup-plugin-visualizer"
  ],
  "workspaces": {
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["dist/**", "**/*.css.ts"],
      "vite": false
    }
  }
}
