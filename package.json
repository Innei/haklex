{
  "name": "haklex",
  "private": true,
  "description": "Modular Lexical-based rich editor ecosystem. Edit, static render, SSR, and server-side parse — all from one schema. React 19, TypeScript 5.9, Vanilla Extract, ESM.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:rich": "pnpm run build:packages",
    "dev": "turbo dev --filter=./demo",
    "lint": "eslint . --fix",
    "litexml": "tsx scripts/litexml/index.ts",
    "prepare": "pnpm exec simple-git-hooks",
    "release": "bumpp -r --no-commit --no-tag --no-push",
    "release:dry": "bumpp -r --no-commit --no-tag --no-push",
    "test": "vitest run",
    "typecheck": "pnpm --filter \"./packages/*\" -r exec tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,yml,yaml}": [
      "eslint --fix"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@lobehub/eslint-config": "^2.1.5",
    "@lobehub/prettier-config": "^2.1.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.6.5",
    "@types/unist": "^3.0.3",
    "@typescript/typescript6": "^6.0.2",
    "@vanilla-extract/css": "^1.21.3",
    "bumpp": "^12.3.0",
    "commitlint": "^21.2.3",
    "eslint": "^10.13.0",
    "knip": "^6.41.0",
    "lint-staged": "17.6.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "simple-git-hooks": "2.14.0",
    "stylelint": "^17.16.0",
    "taze": "^21.3.0",
    "thumbhash": "^0.1.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "unified": "^11.0.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=22.12.0"
  }
}
