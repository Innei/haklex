{
  "name": "@haklex/rich-editor",
  "version": "0.49.0",
  "description": "Core rich text editor based on Lexical",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-editor"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./nodes": "./src/nodes-entry.ts",
    "./plugins": "./src/plugins-entry.ts",
    "./commands": "./src/commands-entry.ts",
    "./renderers": "./src/renderers-entry.ts",
    "./static": "./src/static-entry.ts",
    "./style.css": "./dist/rich-editor.css",
    "./styles": "./src/styles-entry.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@haklex/rich-editor-ui": "workspace:*",
    "@haklex/rich-headless": "workspace:*",
    "@haklex/rich-style-token": "workspace:*",
    "@lexical/code-core": "^0.52.0",
    "nanoid": "^6.0.2",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@lexical/extension": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "katex": "^0.19.0",
    "lexical": "^0.52.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.5.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "katex": ">=0.16.0",
    "lexical": "^0.52.0",
    "lucide-react": "^1.0.0",
    "react": ">=19",
    "react-dom": ">=19",
    "shiki": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./nodes": {
        "import": "./dist/nodes-entry.mjs",
        "types": "./dist/nodes-entry.d.ts"
      },
      "./plugins": {
        "import": "./dist/plugins-entry.mjs",
        "types": "./dist/plugins-entry.d.ts"
      },
      "./commands": {
        "import": "./dist/commands-entry.mjs",
        "types": "./dist/commands-entry.d.ts"
      },
      "./renderers": {
        "import": "./dist/renderers-entry.mjs",
        "types": "./dist/renderers-entry.d.ts"
      },
      "./static": {
        "import": "./dist/static-entry.mjs",
        "types": "./dist/static-entry.d.ts"
      },
      "./styles": {
        "import": "./dist/styles-entry.mjs",
        "types": "./dist/styles-entry.d.ts"
      },
      "./style.css": "./dist/rich-editor.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
