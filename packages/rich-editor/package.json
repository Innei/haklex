{
  "name": "@haklex/rich-editor",
  "version": "0.15.0",
  "description": "Core rich text editor based on Lexical",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-editor"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./nodes": "./src/nodes-entry.ts",
    "./plugins": "./src/plugins-entry.ts",
    "./commands": "./src/commands-entry.ts",
    "./renderers": "./src/renderers-entry.ts",
    "./static": "./src/static-entry.ts",
    "./style.css": "./dist/rich-editor.css",
    "./styles": "./src/styles-entry.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@haklex/rich-editor-ui": "workspace:*",
    "@haklex/rich-headless": "workspace:*",
    "@haklex/rich-style-token": "workspace:*",
    "@lexical/code-core": "^0.44.0",
    "nanoid": "^5.1.11",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@lexical/extension": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/table": "^0.44.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "katex": "^0.16.47",
    "lexical": "^0.44.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "^4.1.0",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.1",
    "vite": "^8.0.13"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.1.0",
    "@lexical/extension": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/table": "^0.44.0",
    "katex": ">=0.16.0",
    "lexical": "^0.44.0",
    "lucide-react": "^1.0.0",
    "react": ">=19",
    "react-dom": ">=19",
    "shiki": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./nodes": {
        "import": "./dist/nodes-entry.mjs",
        "types": "./dist/nodes-entry.d.ts"
      },
      "./plugins": {
        "import": "./dist/plugins-entry.mjs",
        "types": "./dist/plugins-entry.d.ts"
      },
      "./commands": {
        "import": "./dist/commands-entry.mjs",
        "types": "./dist/commands-entry.d.ts"
      },
      "./renderers": {
        "import": "./dist/renderers-entry.mjs",
        "types": "./dist/renderers-entry.d.ts"
      },
      "./static": {
        "import": "./dist/static-entry.mjs",
        "types": "./dist/static-entry.d.ts"
      },
      "./styles": {
        "import": "./dist/styles-entry.mjs",
        "types": "./dist/styles-entry.d.ts"
      },
      "./style.css": "./dist/rich-editor.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
