{
  "name": "@haklex/rich-editor",
  "version": "0.0.11",
  "description": "Core rich text editor based on Lexical",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./editor": "./src/editor.ts",
    "./renderer": "./src/renderer.ts",
    "./style.css": "./dist/rich-editor.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@haklex/rich-editor-ui": "workspace:*",
    "@haklex/rich-headless": "workspace:*",
    "@haklex/rich-style-token": "workspace:*",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.1.0",
    "@lexical/code": "^0.40.0",
    "@lexical/extension": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/markdown": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/table": "^0.40.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.17.1",
    "@vanilla-extract/vite-plugin": "^4.0.20",
    "katex": ">=0.16.0",
    "lexical": "^0.40.0",
    "lucide-react": "^0.574.0",
    "react": ">=19",
    "react-dom": ">=19",
    "shiki": "^3.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.1.0",
    "@lexical/code": "^0.40.0",
    "@lexical/extension": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/markdown": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/table": "^0.40.0",
    "katex": ">=0.16.0",
    "lexical": "^0.40.0",
    "lucide-react": "^0.574.0",
    "react": ">=19",
    "react-dom": ">=19",
    "shiki": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./editor": {
        "import": "./dist/editor.mjs",
        "types": "./dist/editor.d.ts"
      },
      "./renderer": {
        "import": "./dist/renderer.mjs",
        "types": "./dist/renderer.d.ts"
      },
      "./style.css": "./dist/rich-editor.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
