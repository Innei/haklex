{
  "name": "@haklex/rich-ext-chat",
  "version": "0.4.0",
  "description": "Static chat-snapshot node for the haklex rich editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-ext-chat"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./static": "./src/static.ts",
    "./style.css": "./dist/rich-ext-chat.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@streamdown/code": "^1.1.1",
    "nanoid": "^5.1.9",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@haklex/rich-editor": "workspace:*",
    "@lexical/react": "^0.44.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "lexical": "^0.44.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "@haklex/rich-editor": ">=0.3.0",
    "@haklex/rich-editor-ui": ">=0.3.0",
    "@haklex/rich-style-token": ">=0.3.0",
    "lexical": "^0.44.0",
    "lucide-react": "^1.0.0",
    "react": ">=19"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./static": {
        "import": "./dist/static.mjs",
        "types": "./dist/static.d.ts"
      },
      "./style.css": "./dist/rich-ext-chat.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
