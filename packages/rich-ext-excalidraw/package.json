{
  "name": "@haklex/rich-ext-excalidraw",
  "version": "0.0.93",
  "description": "Excalidraw whiteboard extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-ext-excalidraw"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./static": "./src/static.ts",
