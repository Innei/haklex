{
  "name": "@haklex/rich-ext-gallery",
  "type": "module",
  "version": "0.0.64",
  "description": "Image gallery extension with drag-and-drop",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./static": "./src/static.ts",
    "./style.css": "./dist/rich-ext-gallery.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "peerDependencies": {
    "lexical": "^0.41.0",
    "lucide-react": "^0.574.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@haklex/rich-editor": "workspace:*",
    "@haklex/rich-editor-ui": "workspace:*",
    "@haklex/rich-style-token": "workspace:*",
    "react-intersection-observer": "^10.0.3",
    "react-photo-view": "^1.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "lexical": "^0.41.0",
    "lucide-react": "^0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./static": {
        "import": "./dist/static.mjs",
        "types": "./dist/static.d.ts"
      },
      "./style.css": "./dist/rich-ext-gallery.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
