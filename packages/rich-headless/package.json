{
  "name": "@haklex/rich-headless",
  "version": "0.29.0",
  "description": "Headless Lexical node registry for server-side parsing (no React)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-headless"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./transformers": "./src/transformers.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@lexical/code-core": "^0.46.0",
    "@lexical/extension": "^0.46.0",
    "@lexical/link": "^0.46.0",
    "@lexical/list": "^0.46.0",
    "@lexical/markdown": "^0.46.0",
    "@lexical/rich-text": "^0.46.0",
    "@lexical/table": "^0.46.0"
  },
  "devDependencies": {
    "@lexical/headless": "^0.46.0",
    "lexical": "^0.46.0",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.0"
  },
  "peerDependencies": {
    "lexical": "^0.46.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./transformers": {
        "import": "./dist/transformers.mjs",
        "types": "./dist/transformers.d.ts"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
