{
  "name": "@haklex/rich-kit-shiro",
  "version": "0.0.10",
  "description": "Production bundle for Shiroi blog",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./editor": "./src/ShiroEditor.tsx",
    "./renderer": "./src/ShiroRenderer.tsx",
    "./style.css": "./src/style.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist",
    "src/style.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@haklex/rich-editor": "workspace:*",
    "@haklex/rich-editor-ui": "workspace:*",
    "@haklex/rich-ext-code-snippet": "workspace:*",
    "@haklex/rich-ext-tldraw": "workspace:*",
    "@haklex/rich-plugin-block-handle": "workspace:*",
    "@haklex/rich-plugin-floating-toolbar": "workspace:*",
    "@haklex/rich-plugin-link-edit": "workspace:*",
    "@haklex/rich-plugin-slash-menu": "workspace:*",
    "@haklex/rich-plugin-table": "workspace:*",
    "@haklex/rich-renderers": "workspace:*",
    "@haklex/rich-renderers-edit": "workspace:*"
  },
  "devDependencies": {
    "@lexical/react": "^0.40.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lexical": "^0.40.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.0"
  },
  "peerDependencies": {
    "@lexical/react": "^0.40.0",
    "lexical": "^0.40.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./editor": {
        "import": "./dist/editor.mjs",
        "types": "./dist/editor.d.ts"
      },
      "./renderer": {
        "import": "./dist/renderer.mjs",
        "types": "./dist/renderer.d.ts"
      },
      "./style.css": "./src/style.css"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}