{
  "name": "@haklex/rich-litexml",
  "version": "0.22.1",
  "description": "Bidirectional Lexical SerializedNode <-> XML conversion with plugin registry",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-litexml"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./src/index-browser.ts",
      "node": "./src/index-node.ts",
      "default": "./src/index-node.ts"
    }
  },
  "main": "./src/index-node.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "lexical": "^0.45.0",
    "linkedom": "^0.18.12",
    "nanoid": "^5.1.11"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.1",
    "vite": "^8.0.14"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "browser": {
          "import": "./dist/browser.mjs",
          "types": "./dist/index-browser.d.ts"
        },
        "node": {
          "import": "./dist/node.mjs",
          "types": "./dist/index-node.d.ts"
        },
        "default": {
          "import": "./dist/node.mjs",
          "types": "./dist/index-node.d.ts"
        }
      }
    },
    "main": "./dist/node.mjs",
    "types": "./dist/index-node.d.ts"
  }
}
