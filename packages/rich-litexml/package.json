{
  "name": "@haklex/rich-litexml",
  "version": "0.38.0",
  "description": "Bidirectional Lexical SerializedNode <-> XML conversion with plugin registry",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-litexml"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./src/index-browser.ts",
      "node": "./src/index-node.ts",
      "default": "./src/index-node.ts"
    }
  },
  "main": "./src/index-node.ts",
  "files": [
    ".claude/skills/litexml-authoring",
    "dist"
  ],
  "scripts": {
    "build": "vite build && node -e \"const fs=require('node:fs');fs.rmSync('.claude',{recursive:true,force:true});fs.cpSync('../../.claude/skills/litexml-authoring','.claude/skills/litexml-authoring',{recursive:true})\"",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "lexical": "^0.49.0",
    "linkedom": "^0.18.13",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "browser": {
          "import": "./dist/browser.mjs",
          "types": "./dist/index-browser.d.ts"
        },
        "node": {
          "import": "./dist/node.mjs",
          "types": "./dist/index-node.d.ts"
        },
        "default": {
          "import": "./dist/node.mjs",
          "types": "./dist/index-node.d.ts"
        }
      }
    },
    "main": "./dist/node.mjs",
    "types": "./dist/index-node.d.ts"
  }
}
