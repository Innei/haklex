{
  "name": "@haklex/rich-renderer-codeblock",
  "version": "0.0.74",
  "description": "Code block renderer with Shiki syntax highlighting",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-renderer-codeblock"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./icons": "./src/icons/index.ts",
    "./shiki": "./src/shiki.ts",
    "./static": "./src/static.ts",
    "./style.css": "./dist/rich-renderer-codeblock.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@haklex/cm-editor": "workspace:*",
    "@haklex/rich-editor": "workspace:*",
    "@haklex/rich-editor-ui": "workspace:*",
    "@haklex/rich-style-token": "workspace:*",
    "@iconify-json/material-icon-theme": "^1.2.54",
    "@iconify/utils": "^3.1.0",
    "lucide-react": "^0.577.0",
    "shiki": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./static": {
        "import": "./dist/static.mjs",
        "types": "./dist/static.d.ts"
      },
      "./shiki": {
        "import": "./dist/shiki.mjs",
        "types": "./dist/shiki.d.ts"
      },
      "./constants": {
        "import": "./dist/constants.mjs",
        "types": "./dist/constants.d.ts"
      },
      "./style.css": "./dist/rich-renderer-codeblock.css",
      "./icons": {
        "import": "./dist/icons.mjs",
        "types": "./dist/icons.d.ts"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
