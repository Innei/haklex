{
  "name": "@haklex/rich-renderer-codeblock",
  "version": "0.22.0",
  "description": "Code block renderer with Shiki syntax highlighting",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-renderer-codeblock"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./icons": "./src/icons/index.ts",
    "./shiki": "./src/shiki.ts",
    "./static": "./src/static.tsx",
    "./style.css": "./dist/rich-renderer-codeblock.css"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@haklex/cm-editor": "workspace:*",
    "@iconify-json/material-icon-theme": "^1.2.66",
    "@iconify/utils": "^3.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "^4.1.0",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.1",
    "vite": "^8.0.14"
  },
  "peerDependencies": {
    "@haklex/rich-editor": "workspace:*",
    "@haklex/rich-editor-ui": "workspace:*",
    "@haklex/rich-style-token": "workspace:*",
    "lucide-react": "^1.0.0",
    "react": ">=19",
    "react-dom": ">=19",
    "shiki": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./static": {
        "import": "./dist/static.mjs",
        "types": "./dist/static.d.ts"
      },
      "./shiki": {
        "import": "./dist/shiki.mjs",
        "types": "./dist/shiki.d.ts"
      },
      "./constants": {
        "import": "./dist/constants.mjs",
        "types": "./dist/constants.d.ts"
      },
      "./style.css": "./dist/rich-renderer-codeblock.css",
      "./icons": {
        "import": "./dist/icons.mjs",
        "types": "./dist/icons.d.ts"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
