    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@haklex/rich-editor": "workspace:*",
    "@haklex/rich-editor-ui": "workspace:*",
    "@haklex/rich-style-token": "workspace:*",
    "jotai": "2.18.0",
    "lucide-react": "^0.577.0",
    "react-photo-view": "^1.2.7"
  },
  "devDependencies": {
    "@lexical/react": "^0.41.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
