{
  "name": "@haklex/rich-renderers",
  "version": "0.3.4",
  "description": "Static renderers aggregator for haklex rich editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innei/haklex.git",
    "directory": "packages/rich-renderers"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./alert": "./src/alert.ts",
    "./banner": "./src/banner.ts",
    "./code-snippet": "./src/code-snippet.ts",
    "./codeblock": "./src/codeblock.ts",
    "./embed": "./src/embed.ts",
    "./excalidraw": "./src/excalidraw.ts",
    "./gallery": "./src/gallery.ts",
    "./image": "./src/image.ts",
    "./linkcard": "./src/linkcard.ts",
    "./mention": "./src/mention.ts",
    "./mermaid": "./src/mermaid-entry.ts",
    "./ruby": "./src/ruby.ts",
    "./style.css": "./src/style.css",
    "./video": "./src/video.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "dist",
    "src/style.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev:build": "vite build --watch"
  },
  "dependencies": {
    "@haklex/rich-ext-code-snippet": "workspace:*",
    "@haklex/rich-ext-embed": "workspace:*",
    "@haklex/rich-ext-excalidraw": "workspace:*",
    "@haklex/rich-ext-gallery": "workspace:*",
    "@haklex/rich-renderer-alert": "workspace:*",
    "@haklex/rich-renderer-banner": "workspace:*",
    "@haklex/rich-renderer-codeblock": "workspace:*",
    "@haklex/rich-renderer-image": "workspace:*",
    "@haklex/rich-renderer-linkcard": "workspace:*",
    "@haklex/rich-renderer-mention": "workspace:*",
    "@haklex/rich-renderer-mermaid": "workspace:*",
    "@haklex/rich-renderer-ruby": "workspace:*",
    "@haklex/rich-renderer-video": "workspace:*"
  },
  "devDependencies": {
    "@lexical/react": "^0.44.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "lexical": "^0.44.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "@haklex/rich-editor": ">=0.3.0",
    "@lexical/react": "^0.44.0",
    "lexical": "^0.44.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.ts"
      },
      "./alert": {
        "import": "./dist/alert.mjs",
        "types": "./dist/alert.d.ts"
      },
      "./banner": {
        "import": "./dist/banner.mjs",
        "types": "./dist/banner.d.ts"
      },
      "./codeblock": {
        "import": "./dist/codeblock.mjs",
        "types": "./dist/codeblock.d.ts"
      },
      "./gallery": {
        "import": "./dist/gallery.mjs",
        "types": "./dist/gallery.d.ts"
      },
      "./image": {
        "import": "./dist/image.mjs",
        "types": "./dist/image.d.ts"
      },
      "./linkcard": {
        "import": "./dist/linkcard.mjs",
        "types": "./dist/linkcard.d.ts"
      },
      "./mention": {
        "import": "./dist/mention.mjs",
        "types": "./dist/mention.d.ts"
      },
      "./mermaid": {
        "import": "./dist/mermaid.mjs",
        "types": "./dist/mermaid.d.ts"
      },
      "./ruby": {
        "import": "./dist/ruby.mjs",
        "types": "./dist/ruby.d.ts"
      },
      "./style.css": "./src/style.css",
      "./excalidraw": {
        "import": "./dist/excalidraw.mjs",
        "types": "./dist/excalidraw.d.ts"
      },
      "./video": {
        "import": "./dist/video.mjs",
        "types": "./dist/video.d.ts"
      },
      "./embed": {
        "import": "./dist/embed.mjs",
        "types": "./dist/embed.d.ts"
      },
      "./code-snippet": {
        "import": "./dist/code-snippet.mjs",
        "types": "./dist/code-snippet.d.ts"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  }
}
